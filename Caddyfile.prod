# Frontend serving on port 8443 (fallback from Xray)
voiddrop.ru:8443 {
    root * /var/www/voiddrop/frontend
    try_files {path} {path}/ /index.html
    file_server

    # Apply Strict Security Headers directly to static files
    header {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Cross-Origin-Opener-Policy "same-origin"
        Cross-Origin-Embedder-Policy "credentialless"
    }
}

# Backend API reverse proxy on port 8443 (fallback from Xray)
api.voiddrop.ru:8443 {
    @sensitive {
        path /metrics /health
    }
    respond @sensitive "Forbidden" 403

    reverse_proxy localhost:3300
}

