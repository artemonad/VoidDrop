{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "VoidDrop",
  "version": "0.1.0",
  "identifier": "ru.voiddrop.app",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://127.0.0.1:1420/",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "VoidDrop — Secure File Transfer",
        "width": 1100,
        "height": 750,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      }
    }
  }
}
