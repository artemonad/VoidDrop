# Backend Environment Variables
# Copy this file to .env and adjust as necessary.

# TURN Server Config for Time-Limited REST API credentials
TURN_SERVER_URL=turn:your-turn-server.com:3478
TURN_SHARED_SECRET=your-coturn-static-auth-secret

# CORS origins (comma-separated, defaults to localhost + voiddrop.ru)
# CORS_ORIGINS=https://your-domain.com,http://localhost:5173

# Maximum concurrent rooms (default: 1000)
# MAX_ROOMS=1000

# Server port (default: 3300)
# PORT=3300

# Trust proxy headers for rate limiting (default: false)
# TRUST_PROXY=false
