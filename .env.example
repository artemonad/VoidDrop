# VoidDrop Environment Variables Configuration
# Copy this file to .env and adjust as necessary.

# COTURN / WebRTC Configuration
EXTERNAL_IP=your-server-ip
TURN_SERVER_URL=turn:your-server-ip:3478
TURN_SHARED_SECRET=your-coturn-static-auth-secret

# CORS Configuration
CORS_ORIGINS=https://voiddrop.ru,http://localhost:5173,http://localhost:1420
